# ============================================================
# 短链接服务环境变量示例
# 复制本文件为 .env 并按实际情况修改；.env 不会被提交到 Git
# ============================================================

# ---------- Django ----------
# 生产环境务必使用随机长字符串，可用：python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=dev-insecure-secret-key-please-change-me
DJANGO_DEBUG=True
# 多个域名用英文逗号分隔，例如：short.example.com,www.example.com
DJANGO_ALLOWED_HOSTS=*
# CSRF 可信来源（必须带 http(s)://，含端口），逗号分隔；反代/自定义域名时按实际对外地址配置
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://localhost:8088

# ---------- 数据库 ----------
# DB_ENGINE=mysql 使用 MySQL（docker-compose 默认）；
# 留空或 DB_ENGINE=sqlite 使用 SQLite，便于本地零依赖快速启动。
DB_ENGINE=mysql
DB_HOST=db
DB_PORT=3306
DB_NAME=shorturl
DB_USER=shorturl
DB_PASSWORD=shorturl_pass

# ---------- Redis ----------
# docker-compose 内服务名为 cache；本地直连可用 redis://127.0.0.1:6379/0
REDIS_URL=redis://cache:6379/0

# ---------- 站点配置 ----------
# 生成短链接时拼接展示用的对外访问地址，结尾不要带 /
SITE_BASE_URL=http://localhost:8000

# ---------- 功能开关 / 默认值 ----------
# 短码最小展示位数：发号时在自增 ID 上叠加 62^(N-1) 偏移，使短码从 N 位起步（默认 6 位）
SHORT_CODE_MIN_LENGTH=6
# 未登录 / 未带 API Key 时是否允许通过网页生成短链（演示用）
ALLOW_ANONYMOUS_CREATE=True
# 同一 IP 生成短链的限流：时间窗口（秒）与窗口内最大次数
RATE_LIMIT_WINDOW=60
RATE_LIMIT_MAX=30
